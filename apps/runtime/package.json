{
  "name": "@oagent/runtime",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@ag-ui/core": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@strands-agents/sdk": "catalog:",
    "openai": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ag-ui/client": "catalog:",
    "@oagent/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
