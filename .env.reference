# oagent — auto-generated from config struct tags.
# DO NOT edit by hand. Run `go run ./cmd/gen-config-example` to regenerate.
#
# Awareness markers on each field (in [brackets] above the env var):
#   required   — must be non-empty for the app to boot
#   bootstrap  — set once at first-run; changing later has no effect or breaks things
#   secret     — never commit; use env vars or a secret store
#
# Fields split into two top-level sections:
#   BOOTSTRAP — locked at first boot, changing later is NOT SAFE
#   RUNTIME   — safe to change via env + restart
#
# RHS shows the built-in default when present. Secret fields intentionally
# emit no RHS value, even if a default exists internally.


# ════════════════════════════════════════════════════════════════════
#   BOOTSTRAP — set once at first boot; changing later is NOT SAFE
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section lock in behavior for the lifetime of the deployment:
#   - Changing them after first boot has NO effect on already-persisted data
#     (e.g. db.schema and db.tablePrefix require SQL-level intervention).
#
# Read every line here BEFORE first `oagent serve`. Set them deliberately.
#
# ────────────────────────────────────────────────────────────────────

# ─── db ───
# [bootstrap] db.schema
OAGENT_DB_SCHEMA=public
# [bootstrap] db.tablePrefix
OAGENT_DB_TABLE_PREFIX=

# ─── env ───
# [required, bootstrap] env
OAGENT_ENV=production

# ─── mode ───
# [required, bootstrap] mode
OAGENT_MODE=selfhosted


# ════════════════════════════════════════════════════════════════════
#   RUNTIME — safe to change via env + restart
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section can be adjusted between deployments without
# affecting persisted data. Restarting the app picks up the new values.
#
# ────────────────────────────────────────────────────────────────────

# ─── api ───
# api.openapi.enabled
OAGENT_API_OPENAPI_ENABLED=true
# api.openapi.requireBasicAuth
OAGENT_API_OPENAPI_REQUIRE_BASIC_AUTH=true
# api.openapi.basicAuthUser
OAGENT_API_OPENAPI_BASIC_AUTH_USER=
# [secret] api.openapi.basicAuthPassword
OAGENT_API_OPENAPI_BASIC_AUTH_PASSWORD=

# ─── auth ───
# auth.mode
OAGENT_AUTH_MODE=local
# auth.basic.user
OAGENT_AUTH_BASIC_USER=
# [secret] auth.basic.password
OAGENT_AUTH_BASIC_PASSWORD=
# auth.genesis.email
OAGENT_AUTH_GENESIS_EMAIL=
# [secret] auth.genesis.password
OAGENT_AUTH_GENESIS_PASSWORD=
# auth.sessionTTL
OAGENT_AUTH_SESSION_TTL=24h

# ─── cli ───
# cli.sessionFile
OAGENT_CLI_SESSION_FILE=~/.oagent/session.json

# ─── compliance ───
# compliance.requireAcceptance
OAGENT_COMPLIANCE_REQUIRE_ACCEPTANCE=
# compliance.termsURL
OAGENT_COMPLIANCE_TERMS_URL=
# compliance.privacyURL
OAGENT_COMPLIANCE_PRIVACY_URL=
# compliance.termsUpdatedAt
OAGENT_COMPLIANCE_TERMS_UPDATED_AT=

# ─── db ───
# [required, secret] db.dsn
OAGENT_DB_DSN=
# db.role
OAGENT_DB_ROLE=
# db.autoMigrate
OAGENT_DB_AUTO_MIGRATE=true
# [secret] db.reader.dsn
OAGENT_DB_READER_DSN=
# db.reader.role
OAGENT_DB_READER_ROLE=
# db.reader.maxOpenConns
OAGENT_DB_READER_MAX_OPEN_CONNS=
# db.reader.maxIdleConns
OAGENT_DB_READER_MAX_IDLE_CONNS=
# db.reader.connMaxLifetime
OAGENT_DB_READER_CONN_MAX_LIFETIME=
# db.reader.connMaxIdleTime
OAGENT_DB_READER_CONN_MAX_IDLE_TIME=
# [secret] db.migrator.dsn
OAGENT_DB_MIGRATOR_DSN=
# db.migrator.role
OAGENT_DB_MIGRATOR_ROLE=
# db.health.interval
OAGENT_DB_HEALTH_INTERVAL=30s
# db.health.timeout
OAGENT_DB_HEALTH_TIMEOUT=2s
# db.maxOpenConns
OAGENT_DB_MAX_OPEN_CONNS=
# db.maxIdleConns
OAGENT_DB_MAX_IDLE_CONNS=
# db.connMaxLifetime
OAGENT_DB_CONN_MAX_LIFETIME=
# db.connMaxIdleTime
OAGENT_DB_CONN_MAX_IDLE_TIME=
# db.connectTimeout
OAGENT_DB_CONNECT_TIMEOUT=5s
# db.connectBackoff
OAGENT_DB_CONNECT_BACKOFF=250ms

# ─── http ───
# [required] http.addr
OAGENT_HTTP_ADDR=:5150
# http.basePath
OAGENT_HTTP_BASE_PATH=
# http.baseURL
OAGENT_HTTP_BASE_URL=
# http.cookieSecure
OAGENT_HTTP_COOKIE_SECURE=true
# [secret] http.stateSecret
OAGENT_HTTP_STATE_SECRET=

# ─── install ───
# [secret] install.token
OAGENT_INSTALL_TOKEN=

# ─── mail ───
# mail.driver
OAGENT_MAIL_DRIVER=console
# mail.from
OAGENT_MAIL_FROM=
# mail.smtp.host
OAGENT_MAIL_SMTP_HOST=
# mail.smtp.port
OAGENT_MAIL_SMTP_PORT=587
# mail.smtp.username
OAGENT_MAIL_SMTP_USERNAME=
# [secret] mail.smtp.password
OAGENT_MAIL_SMTP_PASSWORD=
# mail.smtp.tls
OAGENT_MAIL_SMTP_TLS=starttls
# mail.smtp.timeout
OAGENT_MAIL_SMTP_TIMEOUT=10s
# [secret] mail.resend.apiKey
OAGENT_MAIL_RESEND_API_KEY=

# ─── mcp ───
# mcp.enabled
OAGENT_MCP_ENABLED=false
# mcp.appsUI
OAGENT_MCP_APPS_UI=
# mcp.audience
OAGENT_MCP_AUDIENCE=
# mcp.audienceOverride
OAGENT_MCP_AUDIENCE_OVERRIDE=
# mcp.challengeToken
OAGENT_MCP_CHALLENGE_TOKEN=
# mcp.challengePrefix
OAGENT_MCP_CHALLENGE_PREFIX=

# ─── queue ───
# queue.enabled
OAGENT_QUEUE_ENABLED=false
# queue.url
OAGENT_QUEUE_URL=
# [secret] queue.token
OAGENT_QUEUE_TOKEN=
# queue.connectTimeout
OAGENT_QUEUE_CONNECT_TIMEOUT=10s

# ─── scheduler ───
# scheduler.enabled
OAGENT_SCHEDULER_ENABLED=true
# scheduler.shutdownGrace
OAGENT_SCHEDULER_SHUTDOWN_GRACE=30s

# ─── secrets ───
# secrets.encryptionKey
OAGENT_SECRETS_ENCRYPTION_KEY=

# ─── telemetry ───
# telemetry.otlp.endpoint
OAGENT_TELEMETRY_OTLP_ENDPOINT=
# telemetry.otlp.protocol
OAGENT_TELEMETRY_OTLP_PROTOCOL=
# telemetry.otlp.insecure
OAGENT_TELEMETRY_OTLP_INSECURE=
# telemetry.otlp.headers
OAGENT_TELEMETRY_OTLP_HEADERS=
# telemetry.tracing.enabled
OAGENT_TELEMETRY_TRACING_ENABLED=
# telemetry.tracing.sampleRatio
OAGENT_TELEMETRY_TRACING_SAMPLE_RATIO=
# telemetry.metrics.enabled
OAGENT_TELEMETRY_METRICS_ENABLED=
# telemetry.metrics.exportInterval
OAGENT_TELEMETRY_METRICS_EXPORT_INTERVAL=30s
# telemetry.metrics.prometheus.enabled
OAGENT_TELEMETRY_METRICS_PROMETHEUS_ENABLED=
# telemetry.metrics.prometheus.addr
OAGENT_TELEMETRY_METRICS_PROMETHEUS_ADDR=:9090
# telemetry.metrics.prometheus.path
OAGENT_TELEMETRY_METRICS_PROMETHEUS_PATH=/metrics
