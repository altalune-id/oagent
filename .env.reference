# auth-server — auto-generated from config struct tags.
# DO NOT edit by hand. Run `go run ./cmd/gen-config-example` to regenerate.
#
# Awareness markers on each field (in [brackets] above the env var):
#   required   — must be non-empty for the app to boot
#   bootstrap  — set once at first-run; changing later has no effect or breaks things
#   secret     — never commit; use env vars or a secret store
#
# Fields split into two top-level sections:
#   BOOTSTRAP — locked at first boot, changing later is NOT SAFE
#   RUNTIME   — safe to change via env + restart
#
# RHS shows the built-in default when present. Secret fields intentionally
# emit no RHS value, even if a default exists internally.


# ════════════════════════════════════════════════════════════════════
#   BOOTSTRAP — set once at first boot; changing later is NOT SAFE
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section lock in behavior for the lifetime of the deployment:
#   - Changing them after first boot has NO effect on already-persisted data
#     (e.g. db.schema and db.tablePrefix require SQL-level intervention).
#
# Read every line here BEFORE first `auth-server serve`. Set them deliberately.
#
# ────────────────────────────────────────────────────────────────────

# ─── db ───
# [bootstrap] db.schema
AUTH_DB_SCHEMA=public
# [bootstrap] db.tablePrefix
AUTH_DB_TABLE_PREFIX=

# ─── env ───
# [required, bootstrap] env
AUTH_ENV=production

# ─── mode ───
# [required, bootstrap] mode
AUTH_MODE=selfhosted


# ════════════════════════════════════════════════════════════════════
#   RUNTIME — safe to change via env + restart
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section can be adjusted between deployments without
# affecting persisted data. Restarting the app picks up the new values.
#
# ────────────────────────────────────────────────────────────────────

# ─── api ───
# api.openapi.enabled
AUTH_API_OPENAPI_ENABLED=true
# api.openapi.requireBasicAuth
AUTH_API_OPENAPI_REQUIRE_BASIC_AUTH=true
# api.openapi.basicAuthUser
AUTH_API_OPENAPI_BASIC_AUTH_USER=
# [secret] api.openapi.basicAuthPassword
AUTH_API_OPENAPI_BASIC_AUTH_PASSWORD=

# ─── db ───
# [required, secret] db.dsn
AUTH_DB_DSN=
# db.role
AUTH_DB_ROLE=
# db.autoMigrate
AUTH_DB_AUTO_MIGRATE=true
# [secret] db.reader.dsn
AUTH_DB_READER_DSN=
# db.reader.role
AUTH_DB_READER_ROLE=
# db.reader.maxOpenConns
AUTH_DB_READER_MAX_OPEN_CONNS=
# db.reader.maxIdleConns
AUTH_DB_READER_MAX_IDLE_CONNS=
# db.reader.connMaxLifetime
AUTH_DB_READER_CONN_MAX_LIFETIME=
# db.reader.connMaxIdleTime
AUTH_DB_READER_CONN_MAX_IDLE_TIME=
# [secret] db.migrator.dsn
AUTH_DB_MIGRATOR_DSN=
# db.migrator.role
AUTH_DB_MIGRATOR_ROLE=
# db.health.interval
AUTH_DB_HEALTH_INTERVAL=30s
# db.health.timeout
AUTH_DB_HEALTH_TIMEOUT=2s
# db.maxOpenConns
AUTH_DB_MAX_OPEN_CONNS=
# db.maxIdleConns
AUTH_DB_MAX_IDLE_CONNS=
# db.connMaxLifetime
AUTH_DB_CONN_MAX_LIFETIME=
# db.connMaxIdleTime
AUTH_DB_CONN_MAX_IDLE_TIME=
# db.connectTimeout
AUTH_DB_CONNECT_TIMEOUT=5s
# db.connectBackoff
AUTH_DB_CONNECT_BACKOFF=250ms

# ─── http ───
# [required] http.addr
AUTH_HTTP_ADDR=:5150
# http.basePath
AUTH_HTTP_BASE_PATH=
# http.baseURL
AUTH_HTTP_BASE_URL=

# ─── mcp ───
# mcp.enabled
AUTH_MCP_ENABLED=false
# mcp.appsUI
AUTH_MCP_APPS_UI=
# mcp.audience
AUTH_MCP_AUDIENCE=
# mcp.audienceOverride
AUTH_MCP_AUDIENCE_OVERRIDE=
# mcp.challengeToken
AUTH_MCP_CHALLENGE_TOKEN=
# mcp.challengePrefix
AUTH_MCP_CHALLENGE_PREFIX=

# ─── queue ───
# queue.enabled
AUTH_QUEUE_ENABLED=false
# queue.url
AUTH_QUEUE_URL=
# [secret] queue.token
AUTH_QUEUE_TOKEN=
# queue.connectTimeout
AUTH_QUEUE_CONNECT_TIMEOUT=10s

# ─── scheduler ───
# scheduler.enabled
AUTH_SCHEDULER_ENABLED=true
# scheduler.shutdownGrace
AUTH_SCHEDULER_SHUTDOWN_GRACE=30s

# ─── telemetry ───
# telemetry.otlp.endpoint
AUTH_TELEMETRY_OTLP_ENDPOINT=
# telemetry.otlp.protocol
AUTH_TELEMETRY_OTLP_PROTOCOL=
# telemetry.otlp.insecure
AUTH_TELEMETRY_OTLP_INSECURE=
# telemetry.otlp.headers
AUTH_TELEMETRY_OTLP_HEADERS=
# telemetry.tracing.enabled
AUTH_TELEMETRY_TRACING_ENABLED=
# telemetry.tracing.sampleRatio
AUTH_TELEMETRY_TRACING_SAMPLE_RATIO=
# telemetry.metrics.enabled
AUTH_TELEMETRY_METRICS_ENABLED=
# telemetry.metrics.exportInterval
AUTH_TELEMETRY_METRICS_EXPORT_INTERVAL=30s
# telemetry.metrics.prometheus.enabled
AUTH_TELEMETRY_METRICS_PROMETHEUS_ENABLED=
# telemetry.metrics.prometheus.addr
AUTH_TELEMETRY_METRICS_PROMETHEUS_ADDR=:9090
# telemetry.metrics.prometheus.path
AUTH_TELEMETRY_METRICS_PROMETHEUS_PATH=/metrics
