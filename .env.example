# development prints emails to the log (console mail driver) and allows http:// webhook URLs.
# For production, set production and configure mail, see the commented lines below.
OAGENT_ENV=development
# roles from scripts/db/provision.sh (the compose Postgres runs it on first start; dev-only passwords)
OAGENT_POSTGRES_DSN=postgres://oagent_service:oagent-dev-service-password@localhost-pooler:5432/oagent?sslmode=disable
OAGENT_POSTGRES_MIGRATOR_DSN=postgres://oagent_migrator:oagent-dev-migrator-password@localhost:5432/oagent?sslmode=disable
OAGENT_POSTGRES_MIGRATOR_ROLE=oagent_owner
# generate: openssl rand -hex 32
OAGENT_HTTP_STATE_SECRET=
# generate: openssl rand -hex 32
OAGENT_SECRETS_ENCRYPTION_KEY=
# console prints emails to the log; refused in production
OAGENT_MAIL_DRIVER=console
# production mail (required when OAGENT_ENV=production):
# OAGENT_HTTP_BASE_URL=https://oagent.example.com
# OAGENT_MAIL_DRIVER=smtp
# OAGENT_MAIL_FROM=oagent <noreply@example.com>
# OAGENT_MAIL_SMTP_HOST=
# or OAGENT_MAIL_DRIVER=resend with OAGENT_MAIL_RESEND_API_KEY=
