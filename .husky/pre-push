#!/usr/bin/env sh
set -eu

node -e 'process.exit(+process.versions.node.split(".")[0] >= 24 ? 0 : 1)' 2>/dev/null || {
  echo "Node 24 is required (found $(node -v 2>/dev/null || echo none)); run: nvm alias default 24 — see .husky/README.md" >&2
  exit 1
}

zero=0000000000000000000000000000000000000000
unverified=0
echo "→ outgoing commits are signed"
while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086 # range holds rev-list arguments
  for c in $(git rev-list $range); do
    # only the header (up to the first blank line) can carry the signature
    if ! git cat-file commit "$c" | sed '/^$/q' | grep -q '^gpgsig'; then
      echo "commit $c is not signed; branch protection rejects unsigned commits." >&2
      echo "fix: git config commit.gpgsign true && git rebase --exec 'git commit --amend --no-edit -S' <base>" >&2
      exit 1
    fi
    if ! git verify-commit "$c" >/dev/null 2>&1; then
      unverified=$((unverified + 1))
    fi
  done
done
if [ "$unverified" -gt 0 ]; then
  echo "note: $unverified signed commit(s) could not be verified on this machine (GPG key not in the keyring or no gpg.ssh.allowedSignersFile); see .husky/README.md"
fi

git fetch --quiet origin main 2>/dev/null || echo "warn: cannot fetch origin/main; using the local ref"
has_main=
git rev-parse --verify --quiet origin/main >/dev/null && has_main=1

echo "→ gofmt -l"
unformatted=$(git ls-files -z '*.go' | xargs -0 gofmt -l)
if [ -n "$unformatted" ]; then
  echo "gofmt: these files need formatting (make fmt):" >&2
  echo "$unformatted" >&2
  exit 1
fi

echo "→ make vet"
make vet

if [ -n "$has_main" ]; then
  echo "→ golangci-lint (issues new since origin/main)"
  make lint-go GOLANGCI_ARGS=--new-from-rev=origin/main
else
  echo "→ golangci-lint"
  make lint-go
fi

echo "→ make comment-check"
make comment-check

echo "→ config examples match the config structs"
make config-check

if [ -n "${PREPUSH_FULL:-}" ] || [ -z "$has_main" ]; then
  echo "→ go test -race -shuffle=on ./..."
  env -u GOROOT GOTOOLCHAIN=auto go test -race -shuffle=on ./...
else
  pkgs=$(git diff --name-only origin/main...HEAD | while IFS= read -r f; do
    d=$(dirname "$f" | sed 's#^testdata\(/.*\)\{0,1\}$#.#; s#/testdata\(/.*\)\{0,1\}$##')
    while [ "$d" != "." ]; do
      if ls "$d"/*.go >/dev/null 2>&1; then
        echo "./$d"
        break
      fi
      d=$(dirname "$d")
    done
  done | sort -u)
  if [ -n "$pkgs" ]; then
    # shellcheck disable=SC2086 # pkgs is a word list
    pkgs=$(env -u GOROOT GOTOOLCHAIN=auto go list -e -f '{{if or .GoFiles .TestGoFiles .XTestGoFiles}}{{.ImportPath}}{{end}}' $pkgs)
  fi
  if [ -z "$pkgs" ]; then
    echo "→ go test: no Go package changed vs origin/main; skipping (PREPUSH_FULL=1 runs every test)"
  else
    echo "→ go test -race -shuffle=on on packages changed vs origin/main (PREPUSH_FULL=1 runs every test)"
    # shellcheck disable=SC2086 # pkgs is a word list
    env -u GOROOT GOTOOLCHAIN=auto go test -race -shuffle=on $pkgs
  fi
fi

echo "→ pre-push OK"
