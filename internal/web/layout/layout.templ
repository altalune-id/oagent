package layout

templ Layout(d LayoutData) {
	<!DOCTYPE html>
	<html lang={ d.lang() }>
		@head(d)
		<body class="min-h-screen bg-base-200 text-sm leading-[normal] text-base-content">
			<main class="flex min-h-screen items-center justify-center p-4">
				{ children... }
			</main>
		</body>
	</html>
}

// Column is the cardless shell of the sign-in page: one narrow column centred on the base surface.
templ Column(d LayoutData) {
	<!DOCTYPE html>
	<html lang={ d.lang() }>
		@head(d)
		<body class="min-h-dvh bg-base-100 text-sm leading-[normal] text-base-content">
			<main class="flex min-h-dvh flex-col items-center justify-center gap-6 px-4 py-10">
				<div class="flex w-full max-w-[25rem] flex-col gap-5">
					{ children... }
				</div>
			</main>
		</body>
	</html>
}

templ head(d LayoutData) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ d.Title } · OAgent</title>
		<link rel="icon" href={ d.Static("/favicon.ico") } sizes="any"/>
		<link rel="icon" type="image/png" sizes="32x32" href={ d.Static("/favicon-32x32.png") }/>
		<link rel="apple-touch-icon" href={ d.Static("/apple-touch-icon.png") }/>
		<link rel="stylesheet" href={ d.Static("/app.css") }/>
	</head>
}

templ Card(title string) {
	<div class="card w-full max-w-md bg-base-100 shadow-sm">
		<div class="card-body gap-4">
			<h1 class="card-title text-2xl">{ title }</h1>
			{ children... }
		</div>
	</div>
}

// Divider separates the OIDC sign-in button from the password form below it.
templ Divider(label string) {
	<div class="divider my-0 text-xs text-base-content/70">{ label }</div>
}
