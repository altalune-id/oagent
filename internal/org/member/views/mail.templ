package views

templ mailLayout(heading string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ heading }</title>
		</head>
		<body style="margin:0;padding:24px 16px;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
			<div style="max-width:480px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7;border-radius:8px;padding:24px;">
				<h1 style="margin:0 0 16px;font-size:20px;line-height:28px;font-weight:600;">{ heading }</h1>
				<div style="font-size:15px;line-height:24px;">
					{ children... }
				</div>
			</div>
		</body>
	</html>
}

// RemovedHTML is the notice sent to a person removed from org.
templ RemovedHTML(org string) {
	@mailLayout(RemovedSubject(org)) {
		<p style="margin:0 0 12px;">You are no longer a member of { org }.</p>
		<p style="margin:0 0 12px;">Your sessions have ended and your personal API keys for this organization were revoked.</p>
		<p style="margin:0;color:#71717a;">If you think this is a mistake, ask an owner or admin of { org } to add you back.</p>
	}
}

// RoleChangedHTML is the notice sent to a person whose role in org is now role.
templ RoleChangedHTML(org string, role string, consoleURL string) {
	@mailLayout(RoleChangedSubject(org, role)) {
		<p style="margin:0 0 12px;">Your role in { org } is now { role }.</p>
		<p style="margin:0 0 20px;">Please sign in again to continue with your new permissions.</p>
		<p style="margin:0;">
			<a href={ templ.SafeURL(consoleURL) } style="display:inline-block;padding:10px 16px;background:#18181b;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">Open the console</a>
		</p>
	}
}
