package views

import "altalune.id/oagent/internal/web/layout"

// LoginData is the sign-in form's state; the password is never echoed back.
type LoginData struct {
	Email    string
	ReturnTo string
	Error    string
}

templ Login(d layout.LayoutData, v LoginData) {
	@layout.Layout(d) {
		@layout.Card(d.Title) {
			if v.Error != "" {
				<div role="alert" class="alert alert-error alert-soft">{ v.Error }</div>
			}
			<form method="post" action={ d.Href("/login") } class="flex flex-col gap-3">
				if v.ReturnTo != "" {
					<input type="hidden" name="return_to" value={ v.ReturnTo }/>
				}
				<label class="floating-label">
					<span>Email</span>
					<input class="input w-full" type="email" name="email" value={ v.Email } placeholder="Email" autocomplete="username" required autofocus/>
				</label>
				<label class="floating-label">
					<span>Password</span>
					<input class="input w-full" type="password" name="password" placeholder="Password" autocomplete="current-password" required/>
				</label>
				<button class="btn btn-primary mt-2" type="submit">Sign in</button>
			</form>
			<p class="text-xs text-base-content/60">
				<a class="link" href={ d.Href("/terms") }>Terms</a> · <a class="link" href={ d.Href("/privacy") }>Privacy</a>
			</p>
		}
	}
}
